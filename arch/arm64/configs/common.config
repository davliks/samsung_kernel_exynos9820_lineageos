# Disable Securities
CONFIG_UH_LKMAUTH=n
# BakaSU (ReSukiSU)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y



# TTL fix for VirtualAP
CONFIG_NETFILTER_XT_TARGET_HL=y

# USB gadget functions for USB-Arsenal and NetHunter
# https://github.com/ravindu644/USB-Arsenal
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_F_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_F_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_F_EEM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_FS=y

# USB host-side CDC ACM modem
CONFIG_USB_ACM=y

CONFIG_USB_UAS=y

# Working set protection (le9): keep 128M anon, 64M/32M clean file pages
CONFIG_ANON_MIN_KBYTES=131072
CONFIG_CLEAN_LOW_KBYTES=65536
CONFIG_CLEAN_MIN_KBYTES=32768

# Boost all CPUs to max for 2s on fingerprint input
CONFIG_FINGERPRINT_BOOST=y

# CUBIC as the default congestion control. BBR on 4.14, even with the
# ack-aggregation backport, moved one TCP stream to a Wi-Fi 6 hotspot
# client at ~68 MB/s against ~88 MB/s for CUBIC. BBR stays built in for
# sockets that ask for it.
# CONFIG_DEFAULT_BBR is not set
CONFIG_DEFAULT_CUBIC=y

# ==========================================
# 1. Таймеры, модель вытеснения и планировщик Exynos 9825
# ==========================================
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set

# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_VOLUNTARY=y

# Старт на максимальных частотах с первой миллисекунды загрузки
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

# Запрет сваливать системные workqueue (UFS, USB, сеть) на слабые ядра A55
# CONFIG_WQ_POWER_EFFICIENT_DEFAULT is not set

# Для headless-сервера буст от сканера отпечатков не нужен
# CONFIG_FINGERPRINT_BOOST is not set

# ==========================================
# 2. Дополнение к droidspaces.config (Cgroups и IPC)
# ==========================================
# В droidspaces.config включён MEMCG_SWAP, но без этой опции нужен swapaccount=1 в cmdline
CONFIG_MEMCG_SWAP_ENABLED=y

# Критично: без CPUSETS нельзя вытащить контейнеры из мобильного background-пула A55
CONFIG_CPUSETS=y

# Лимиты дискового I/O (--blkio-weight, --device-read-bps) для Docker / systemd
CONFIG_BLK_CGROUP=y

# Ускорение межпроцессного обмена памятью (process_vm_readv/writev) в контейнерах
CONFIG_CROSS_MEMORY_ATTACH=y

# ==========================================
# 3. Сетевой стек в пару к твоему CONFIG_DEFAULT_CUBIC=y
# ==========================================
# Лучшая дисциплина очередей для CUBIC (убирает bufferbloat без потери пиковой скорости)
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_DEFAULT_NET_SCH="fq_codel"

# Распределение прерываний и пакетов USB-Ethernet по всем 8 ядрам CPU
CONFIG_RPS=y
CONFIG_RFS_ACCEL=y
CONFIG_XPS=y

# JIT-компиляция BPF (ускоряет iptables/UFW из droidspaces.config и seccomp)
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# Альтернатива MACVLAN, если свитч/роутер режет несколько MAC-адресов на порту
CONFIG_IPVLAN=y

# ==========================================
# 4. Файловые системы, блочный I/O и память (дополнение к le9)
# ==========================================
# Дополнение к CONFIG_OVERLAY_FS=y для корректного rename() директорий в слоях Docker
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y

# Защита задержек чтения (БД/контейнеры) при тяжелой фоновой записи на UFS 3.0
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y

# Увеличенный пул loop-устройств (по умолчанию 8 — быстро кончаются при монтировании .img)
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16

# Для внешних SSD по USB UAS (Btrfs с compression=zstd и снапшотами)
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# 2-мегабайтные страницы памяти только для процессов, запрашивающих их через madvise
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

